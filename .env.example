# Local-only development credentials. Replace all values outside local development.
MAHFEL_POSTGRES_DB=mahfel
MAHFEL_POSTGRES_USER=mahfel
MAHFEL_POSTGRES_PASSWORD=mahfel-local-only
MAHFEL_REDIS_URL=redis://redis:6379

# Loopback-only host ports. Change these when another local stack owns a default.
MAHFEL_CADDY_HTTP_HOST_PORT=80
MAHFEL_CADDY_HTTPS_HOST_PORT=443
MAHFEL_POSTGRES_HOST_PORT=5432
MAHFEL_REDIS_HOST_PORT=6379

MAHFEL_RABBITMQ_USER=mahfel
MAHFEL_RABBITMQ_PASSWORD=mahfel-local-only
MAHFEL_AMQP_URL=amqp://mahfel:mahfel-local-only@rabbitmq:5672/%2f
MAHFEL_RABBITMQ_AMQP_HOST_PORT=5672
MAHFEL_RABBITMQ_MANAGEMENT_HOST_PORT=15672
MAHFEL_RABBITMQ_METRICS_HOST_PORT=15692

MAHFEL_S3_BUCKET=mahfel-local
MAHFEL_S3_ENDPOINT=http://rustfs:9000
MAHFEL_S3_PUBLIC_ENDPOINT=https://s3.mahfel.localhost
MAHFEL_S3_REGION=us-east-1
MAHFEL_S3_ACCESS_KEY=mahfel
MAHFEL_S3_SECRET_KEY=mahfel-local-only-secret
MAHFEL_S3_FORCE_PATH_STYLE=true
MAHFEL_RUSTFS_API_HOST_PORT=9000
MAHFEL_RUSTFS_CONSOLE_HOST_PORT=9001

# Local OIDC provider (TinyAuth). Test users are in deploy/tinyauth/users and
# all use the local-only password "password". Production may use Keycloak.
MAHFEL_TINYAUTH_HOST_PORT=8081

MAHFEL_TURN_USER=mahfel
MAHFEL_TURN_PASSWORD=mahfel-local-only
MAHFEL_TURN_REALM=mahfel.local
MAHFEL_TURN_EXTERNAL_IP=127.0.0.1
MAHFEL_TURN_RELAY_MIN_PORT=49160
MAHFEL_TURN_RELAY_MAX_PORT=49200

MAHFEL_GRAFANA_ADMIN_USER=admin
MAHFEL_GRAFANA_ADMIN_PASSWORD=mahfel-local-only
MAHFEL_PROMETHEUS_HOST_PORT=9090
MAHFEL_ALERTMANAGER_HOST_PORT=9093
MAHFEL_GRAFANA_HOST_PORT=3300

# Browser-visible configuration is embedded into the frontend at build time.
NEXT_PUBLIC_MAHFEL_API_URL=https://api.mahfel.localhost
MAHFEL_OIDC_ISSUER_URL=https://auth.mahfel.localhost

# Use the public/stable IP or DNS name of a media replica outside local development.
MAHFEL_MEDIA_ANNOUNCED_ADDRESS=127.0.0.1
MAHFEL_MEDIA_WORKER_COUNT=4
MAHFEL_MEDIA_RTC_PORT_MIN=40000
MAHFEL_MEDIA_RTC_PORT_MAX=40003
MAHFEL_LOG_FILTER=info,mahfel=debug,tower_http=info
