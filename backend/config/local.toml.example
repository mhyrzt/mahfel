# Copy this file to local.toml for host-only overrides. Environment variables
# use MAHFEL_ plus double underscores for nesting, for example:
# MAHFEL_DATABASE__HOST=127.0.0.1

[database]
host = "127.0.0.1"
port = 5432
user = "mahfel"
password = "mahfel-local"
name = "mahfel"
migrate_on_start = true

[api]
media_grpc_url = "http://127.0.0.1:50051"
media_registry_bind = "127.0.0.1:50052"

[media]
grpc_advertise_url = "http://127.0.0.1:50051"
registry_url = "http://127.0.0.1:50052"

[oidc]
issuer_url = "https://auth.mahfel.localhost/realms/rastai"
client_id = "mahfel-api"
client_secret = "mahfel-dev-secret"
redirect_uri = "https://api.mahfel.localhost/v1/auth/oidc/callback"
scopes = ["openid", "profile", "email", "roles"]

[keycloak]
base_url = "https://auth.mahfel.localhost"
realm = "rastai"
admin_client_id = "mahfel-admin"
admin_client_secret = "mahfel-admin-dev-secret"

[worker]
amqp_url = "amqp://mahfel:mahfel-local@127.0.0.1:5672/%2f"
