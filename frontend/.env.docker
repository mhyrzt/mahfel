# Local Compose runtime configuration. Never use these development credentials outside a local stack.
NEXT_PUBLIC_MAHFEL_API_URL=https://api.mahfel.localhost
NEXTAUTH_URL=https://mahfel.localhost
NEXTAUTH_SECRET=mahfel-compose-local-only-nextauth-secret
KEYCLOAK_ISSUER=https://auth.mahfel.localhost/realms/rastai
KEYCLOAK_TOKEN_ENDPOINT=http://keycloak:8080/realms/rastai/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=mahfel-web
KEYCLOAK_CLIENT_SECRET=mahfel-web-dev-secret
MAHFEL_API_URL=http://mahfel-api:8080
NODE_EXTRA_CA_CERTS=/certs/root.crt
