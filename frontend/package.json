{
  "name": "mahfel-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "generate:api": "bun run generate:rest && bun run generate:ws",
    "generate:rest": "openapi-typescript ../specs/openapi.json --output lib/api/generated/schema.ts && prettier --write lib/api/generated/schema.ts",
    "generate:ws": "bun scripts/generate-websocket-types.ts && prettier --write lib/websocket/generated/messages.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright/playwright.config.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@lexical/link": "^0.51.0",
    "@lexical/list": "^0.51.0",
    "@lexical/react": "^0.51.0",
    "@lexical/rich-text": "^0.51.0",
    "@lexical/selection": "^0.51.0",
    "@lexical/yjs": "^0.51.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lexical": "^0.51.0",
    "lib0": "^0.2.117",
    "lucide-react": "^0.544.0",
    "mediasoup-client": "^3.13.0",
    "next": "16.3.3",
    "next-auth": "4.24.11",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.3.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/nextjs": "10.6.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.3.9",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.1.0",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.6",
    "storybook": "10.6.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
