set dotenv-path := "../.env"
set dotenv-load

default:
    @just --list

# Install frontend dependencies from the frozen Bun lockfile.
install:
    bun install --frozen-lockfile

# Start the Next.js development server.
dev:
    bun run dev

# Check formatting without modifying files.
fmt:
    bun run format

# Apply Prettier formatting to frontend files.
fmt-write:
    bun run format:write

# Run the strict ESLint configuration.
lint:
    bun run lint

# Run the TypeScript compiler without emitting files.
typecheck:
    bun run typecheck

# Generate REST and WebSocket types from the API-owned contract artifacts.
generate-api:
    bun run generate:api

# Run frontend unit tests.
test:
    bun run test

# Run Vitest in watch mode during local development.
test-watch:
    bun run test:watch

# Start the Storybook component development server.
storybook:
    bun run storybook

# Build the static Storybook artifact.
storybook-build:
    bun run storybook:build

# Create the production Next.js build.
build:
    bun run build

# Build the web image used by the local Compose stack.
docker:
    docker build \
        --target runtime \
        --tag "mahfel-web:local" \
        --file frontend/Dockerfile ..
